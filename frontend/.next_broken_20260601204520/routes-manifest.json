{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/blog/[postSlug]",
      "regex": "^/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPpostSlug": "nxtPpostSlug"
      },
      "namedRegex": "^/blog/(?<nxtPpostSlug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/questions/[questionId]",
      "regex": "^/questions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPquestionId": "nxtPquestionId"
      },
      "namedRegex": "^/questions/(?<nxtPquestionId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/terms/[termId]",
      "regex": "^/terms/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtermId": "nxtPtermId"
      },
      "namedRegex": "^/terms/(?<nxtPtermId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/architectures",
      "regex": "^/architectures(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/architectures(?:/)?$"
    },
    {
      "page": "/blog",
      "regex": "^/blog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/blog(?:/)?$"
    },
    {
      "page": "/comparisons",
      "regex": "^/comparisons(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/comparisons(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/disclaimer",
      "regex": "^/disclaimer(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/disclaimer(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/privacy",
      "regex": "^/privacy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy(?:/)?$"
    },
    {
      "page": "/questions",
      "regex": "^/questions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/questions(?:/)?$"
    },
    {
      "page": "/questions/clf",
      "regex": "^/questions/clf(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/questions/clf(?:/)?$"
    },
    {
      "page": "/roadmap",
      "regex": "^/roadmap(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/roadmap(?:/)?$"
    },
    {
      "page": "/terms",
      "regex": "^/terms(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/terms(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}