{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/architectures/layout,_N_T_/architectures/page,_N_T_/architectures"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/architectures/__PAGE__",
    "/architectures",
    "/_index",
    "/_head"
  ]
}